APP_NAME=Inboxly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# React SPA origin. Used for CORS, Sanctum stateful domains, email links,
# and Shopify OAuth browser redirects (success/error/cancel).
# Local default: http://127.0.0.1:5173
# Public HTTPS OAuth: set to the frontend Cloudflare/tunnel origin, e.g.
#   FRONTEND_URL=https://cemetery-nextel-tribal-far.trycloudflare.com
# Never leave this as localhost when merchants authorize through a public HTTPS callback.
FRONTEND_URL=http://127.0.0.1:5173

# Comma-separated hosts[:port] allowed to use cookie (SPA) authentication.
# Must include the frontend host used by the browser.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# Exact CORS origins (credentials enabled). Defaults to FRONTEND_URL when omitted.
# Production example: https://app.example.com
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MySQL — dedicated Inboxly databases only
# Do NOT point this at nexora, datasyncai, recovery dumps, or shared DBs.
# Application DB: inboxly
# Automated tests: inboxly_testing (forced in phpunit.xml)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inboxly
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP development: false. Production HTTPS: true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# Cross-origin SPA on another port (localhost:5173 -> :8000) uses SameSite=lax
SESSION_SAME_SITE=lax
# SESSION_COOKIE=inboxly-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed ProcessContactExportJob timeout (300s). Default 360.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=inboxly_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: log (writes to storage/logs). Switch to smtp when ready.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Future SMTP example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Brevo REST API (Phase 9 campaign send). Keep secret; never commit real values.
# Use an API key that starts with xkeysib- (SMTP keys xsmtpsib- will return unauthorized).
BREVO_API_KEY=
# BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="${APP_NAME}"
# Must be true for real Brevo API calls (keep false until domain is verified).
BREVO_SENDING_ENABLED=false
# Per-call timeout for Brevo HTTP requests (seconds).
BREVO_TIMEOUT_SECONDS=20
# Bearer token configured on the Brevo webhook (auth.type=bearer). Required for /api/v1/brevo/webhooks.
BREVO_WEBHOOK_SECRET=
# MESSAGING_EMAIL_DRIVER=fake|brevo — defaults to fake; never auto-selects brevo.
MESSAGING_EMAIL_DRIVER=fake
# Real Brevo locally (optional): set MESSAGING_EMAIL_DRIVER=brevo, BREVO_SENDING_ENABLED=true,
# BREVO_API_KEY (xkeysib-…), BREVO_SENDER_EMAIL (verified sender), then run queue workers. Keep false in CI.
# SMS: disabled | fake | vonage. Config default is disabled until a provider is wired.
# Real Vonage: MESSAGING_SMS_DRIVER=vonage, VONAGE_SMS_SENDING_ENABLED=true,
# VONAGE_API_KEY, VONAGE_API_SECRET, VONAGE_FROM, then run queue workers. Keep false in CI.
MESSAGING_SMS_DRIVER=disabled
# Vonage (Nexmo) SMS — paste credentials locally; never commit real values.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# E.164 sender number or approved alphanumeric brand (account-dependent).
VONAGE_FROM=
# Hard gate: false keeps VonageSmsSender from calling the API.
VONAGE_SMS_SENDING_ENABLED=false
VONAGE_TIMEOUT_SECONDS=20
# VONAGE_BASE_URL=https://rest.nexmo.com

CAMPAIGN_SEND_BATCH_SIZE=100
CAMPAIGN_SEND_MAX_ATTEMPTS=3
CAMPAIGN_RECIPIENT_LEASE_SECONDS=120
CAMPAIGN_DAILY_CAP_PER_STORE=500

# Meta / Facebook (Page connect + campaign feed/photos publish).
# META_DRIVER=fake|meta — defaults to fake; real Graph calls require META_DRIVER=meta.
META_DRIVER=fake
META_APP_ID=
META_APP_SECRET=
# Must match a Valid OAuth Redirect URI in the Meta app dashboard.
META_REDIRECT_URI="${APP_URL}/api/v1/meta/oauth/callback"
# Explicit Graph API version (do not omit; pin intentionally).
META_GRAPH_VERSION=v25.0
# Facebook Login for Business: create a Configuration with pages_show_list,
# pages_read_engagement, pages_manage_posts, then paste its Configuration ID.
META_CONFIG_ID=
# META_SCOPES used only when META_CONFIG_ID is empty (classic Login).
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
META_OAUTH_STATE_TTL=600
META_TIMEOUT_SECONDS=20
META_TOKEN_EXPIRY_SKEW_SECONDS=120
META_PUBLISH_MAX_ATTEMPTS=3
# Keep above ProcessMetaPublicationJob timeout (120s) and queue worker --timeout.
META_PUBLISH_LEASE_SECONDS=180
# Ignored for staging/production: fake publishing is hard-denied outside local/testing.
META_ALLOW_FAKE_PUBLISH=false

# S3-compatible storage (AWS S3 / Cloudflare R2). Leave empty for local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Shopify Partner app (standalone SaaS OAuth / Admin API)
# Paste Client ID and App secret from the Shopify Partner dashboard.
# SHOPIFY_SCOPES: comma-separated scopes requested at OAuth authorize time.
#   Default (when unset): read_customers,write_customers,read_products,read_orders,read_all_orders
#   Must include every required commerce scope. Explicit empty/whitespace is
#   rejected at OAuth start (never redirects with scope=).
#   write_customers enables Inboxly → Shopify contact write-back.
#   Do not add read_brand — Partner Dev Dashboard often cannot select it.
#   Brand import: soft-tries shop.brand, then live theme colors via read_themes,
#   then shop profile. Enable read_themes in Partner Admin API scopes + reconnect.
#   Checkout Branding scopes are unrelated (checkout UI / Plus).
#   read_all_orders requires Partner API access approval AND merchant reauth
#   on each store after the scope is added. Existing connections keep their
#   previously granted scopes until the merchant reconnects.
#   Protected customer data is a separate Shopify approval — not implied here.
# SHOPIFY_REDIRECT_URI: HTTPS OAuth callback URL registered in the Partner app
#   (must match exactly). Path must be: /api/v1/shopify/oauth/callback
#   Example: https://<backend-host>/api/v1/shopify/oauth/callback
# SHOPIFY_WEBHOOK_URI: required public HTTPS webhook endpoint Shopify posts to.
#   Path: /api/v1/shopify/webhooks
#   Production: stable public HTTPS host (not localhost / private IP / .test).
#   Local development: use a tunnel, e.g. https://<subdomain>.ngrok-free.dev/api/v1/shopify/webhooks
# SHOPIFY_WEBHOOK_ALLOW_LOCAL: development-only escape hatch for localhost/.test hosts.
#   Leave false (or unset) in every shared/staging/production environment.
# ---------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_APP_SECRET=
SHOPIFY_SCOPES=read_customers,write_customers,read_products,read_orders,read_all_orders,read_checkouts,read_themes
SHOPIFY_REDIRECT_URI=
SHOPIFY_WEBHOOK_URI=
SHOPIFY_WEBHOOK_ALLOW_LOCAL=false
# Commerce sync batching (customers/products/orders GraphQL pages).
# SHOPIFY_SYNC_PAGE_SIZE=50
# SHOPIFY_SYNC_MAX_PAGES_PER_ATTEMPT=5
# SHOPIFY_SYNC_LEASE_SECONDS=180
# Partner Dashboard App URL for install continuation (shop picker → Inboxly):
#   {FRONTEND_URL}/shopify/install
# Allowed redirection URL remains SHOPIFY_REDIRECT_URI (oauth/callback).
# Onboarding email OTP
AUTH_EMAIL_OTP_TTL_MINUTES=10
AUTH_EMAIL_OTP_MAX_ATTEMPTS=5

# Compliance lease uses job $timeout (120s), not queue:work --timeout. Keep ≥180 (code floor
# timeout+60); default 300. Staging requires pcntl + database queue with DB_QUEUE_RETRY_AFTER
# greater than job timeout (360 default). See docs/M1-COMPLIANCE-OPERATIONS.md.
SHOPIFY_COMPLIANCE_PROCESSING_LEASE_SECONDS=300
SHOPIFY_COMPLIANCE_RECOVER_RECEIVED_OLDER_THAN=60
SHOPIFY_COMPLIANCE_RECOVER_LIMIT=50
SHOPIFY_COMPLIANCE_OPS_RECEIVED_OLDER_THAN=3600
