APP_NAME=Inboxly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# React SPA origin. Used for CORS, Sanctum stateful domains, email links,
# and Shopify OAuth browser redirects (success/error/cancel).
# Local default: http://127.0.0.1:5173
# Public HTTPS OAuth: set to the frontend Cloudflare/tunnel origin, e.g.
#   FRONTEND_URL=https://cemetery-nextel-tribal-far.trycloudflare.com
# Never leave this as localhost when merchants authorize through a public HTTPS callback.
FRONTEND_URL=http://127.0.0.1:5173

# Comma-separated hosts[:port] allowed to use cookie (SPA) authentication.
# Must include the frontend host used by the browser.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# Exact CORS origins (credentials enabled). Defaults to FRONTEND_URL when omitted.
# Production example: https://app.example.com
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MySQL — dedicated Inboxly databases only
# Do NOT point this at nexora, datasyncai, recovery dumps, or shared DBs.
# Application DB: inboxly
# Automated tests: inboxly_testing (forced in phpunit.xml)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inboxly
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP development: false. Production HTTPS: true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# Cross-origin SPA on another port (localhost:5173 -> :8000) uses SameSite=lax
SESSION_SAME_SITE=lax
# SESSION_COOKIE=inboxly-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed ProcessContactExportJob timeout (300s). Default 360.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=inboxly_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: log (writes to storage/logs). Switch to smtp when ready.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Future SMTP example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Brevo REST API (Phase 9 campaign send). Keep secret; never commit real values.
BREVO_API_KEY=
# BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="${APP_NAME}"
# Must be true for real Brevo API calls (keep false until domain is verified).
BREVO_SENDING_ENABLED=false
# MESSAGING_EMAIL_DRIVER=fake|brevo
MESSAGING_EMAIL_DRIVER=fake
# SMS provider deferred
MESSAGING_SMS_DRIVER=disabled
CAMPAIGN_SEND_BATCH_SIZE=100
CAMPAIGN_SEND_MAX_ATTEMPTS=3
CAMPAIGN_DAILY_CAP_PER_STORE=500

# S3-compatible storage (AWS S3 / Cloudflare R2). Leave empty for local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Shopify Partner app (standalone SaaS OAuth / Admin API)
# Paste Client ID and App secret from the Shopify Partner dashboard.
# SHOPIFY_SCOPES: comma-separated; leave empty for connection-only foundation
#   (no customer, order, or product scopes yet).
# SHOPIFY_REDIRECT_URI: HTTPS OAuth callback URL registered in the Partner app
#   (must match exactly). Path must be: /api/v1/shopify/oauth/callback
#   Example: https://<backend-host>/api/v1/shopify/oauth/callback
# SHOPIFY_WEBHOOK_URI: required public HTTPS webhook endpoint Shopify posts to.
#   Path: /api/v1/shopify/webhooks
#   Production: stable public HTTPS host (not localhost / private IP / .test).
#   Local development: use a tunnel, e.g. https://<subdomain>.ngrok-free.dev/api/v1/shopify/webhooks
# SHOPIFY_WEBHOOK_ALLOW_LOCAL: development-only escape hatch for localhost/.test hosts.
#   Leave false (or unset) in every shared/staging/production environment.
# ---------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_APP_SECRET=
SHOPIFY_SCOPES=
SHOPIFY_REDIRECT_URI=
SHOPIFY_WEBHOOK_URI=
SHOPIFY_WEBHOOK_ALLOW_LOCAL=false
